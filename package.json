{
  "name": "autoinfra-agent",
  "version": "1.2.0",
  "description": "AI-assisted infrastructure and deployment toolkit for developers managing VPS servers, containers, and cloud environments.",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint src/ --fix",
    "docker:build": "docker build -t autoinfra-agent .",
    "docker:run": "docker-compose up -d",
    "docker:stop": "docker-compose down",
    "generate:logs": "node scripts/generate-sample-logs.js",
    "setup": "bash scripts/setup.sh",
    "health": "node src/scripts/health-check.js",
    "docs": "npx serve docs/"
  },
  "keywords": [
    "infrastructure",
    "deployment",
    "devops",
    "ai-agent",
    "docker",
    "automation",
    "vps",
    "cloud",
    "server-monitoring",
    "task-queue",
    "websocket",
    "express"
  ],
  "author": "AutoInfra Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/autoinfra/autoinfra-agent"
  },
  "bugs": {
    "url": "https://github.com/autoinfra/autoinfra-agent/issues"
  },
  "homepage": "https://github.com/autoinfra/autoinfra-agent#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "morgan-json": "^1.1.0",
    "node-cron": "^3.0.3",
    "uuid": "^10.0.0",
    "winston": "^3.14.0",
    "ws": "^8.18.0",
    "yaml": "^2.5.0",
    "dockerode": "^4.0.4",
    "axios": "^1.7.5",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "eslint": "^9.9.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  }
}